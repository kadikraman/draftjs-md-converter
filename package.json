{
  "name": "draftjs-md-converter",
  "version": "1.5.2",
  "description": "Converter for converting Draft.js state into Markdown and vice versa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts"
  ],
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "tsdown",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build",
    "deploy-demo": "cd demo && yarn build && gh-pages -d build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadikraman/draftjs-md-converter.git"
  },
  "keywords": [
    "Draft.js",
    "Markdown",
    "converter",
    "react",
    "rich",
    "text",
    "editor"
  ],
  "author": "Kadi Kraman",
  "bugs": {
    "url": "https://github.com/kadikraman/draftjs-md-converter/issues"
  },
  "homepage": "https://kadikraman.github.io/draftjs-md-converter",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "gh-pages": "^3.1.0",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@textlint/markdown-to-ast": "^15.8.0"
  }
}
